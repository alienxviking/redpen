# Copy to .env . Never commit the real file.
#
# GradeSense runs with no key at all: it falls back to a deterministic offline grader
# and labels every result as degraded. Set ONE of the keys below to grade for real.
#
#   Provider   Cost   Sees the diagrams?
#   Claude     paid   yes
#   Gemini     FREE   yes   <- best free choice for this paper
#   Groq       FREE   no    <- fastest, but the two diagram questions get flagged

# --- Option 1: Claude (paid, best quality) -----------------------------------
ANTHROPIC_API_KEY=
GRADER_MODEL=claude-opus-5

# --- Option 2: Google Gemini (FREE tier) -------------------------------------
# Key: https://aistudio.google.com/apikey
# The free option that still accepts the answer PDF, so the circuit diagram and the
# supply/demand graph can actually be marked rather than flagged.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Option 3: Groq (FREE tier) ----------------------------------------------
# Key: https://console.groq.com/keys
# Much faster with more generous limits, but text-only: it cannot see the two
# diagrams, so those questions are flagged for human review instead of marked.
# GROQ_BASE_URL also points this same adapter at OpenRouter, Together, vLLM or
# LM Studio without any code change - they all speak the same wire format.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Selection ----------------------------------------------------------------
# auto (default) prefers Claude, then Gemini, then Groq, then the offline grader.
# That order is about capability, not cost: Claude and Gemini can see the answer PDF.
# Force one with: anthropic | gemini | groq | mock
GRADER_PROVIDER=auto

PORT=5174

# --- Advanced (all optional; defaults shown) ---------------------------------
# Characters below which an answer paper is treated as blank.
# BLANK_THRESHOLD=40
# Token ceiling for one grading call.
# GRADER_MAX_TOKENS=16000
# How long to wait for the grader before giving up and degrading.
# GRADER_TIMEOUT_MS=120000
# Largest PDF accepted by the upload endpoint, in bytes (25 MB).
# MAX_UPLOAD_BYTES=26214400
# Where uploads, extractions and the grading index are written.
# GRADESENSE_DATA_DIR=server/data
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY.
